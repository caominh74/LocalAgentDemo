# Demo 1 (Naive Agent) — copy to `.env` and edit.
# One file for Nest (PORT, LLM_*, WORKSPACE_DIR) and Vite (VITE_*).

PORT=3001
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen2.5-1.5b-instruct
LLM_API_KEY=lm-studio
WORKSPACE_DIR=../sandbox

VITE_API_BASE_URL=http://localhost:3001
VITE_LLM_BASE_URL=http://localhost:1234/v1
VITE_LLM_MODEL=qwen2.5-1.5b-instruct
VITE_LLM_API_KEY=lm-studio
