# ==============================================================================
# 01-basic-agent: Server Environment Variables
# ==============================================================================

# Backend Port (Default: 3001)
PORT=3001

# Local LLM API Endpoint (OpenAI-compatible)
# - Ollama default: http://localhost:11434/v1
# - vLLM default:   http://localhost:8000/v1
LLM_BASE_URL=http://localhost:11434/v1

# Target Local Model Name
# Examples: llama3.2, qwen2.5-coder:7b, mistral, deepseek-r1:7b
LLM_MODEL=llama3.2

# Optional API Key (leave empty or use 'ollama' for local inference)
LLM_API_KEY=ollama

# Root directory for file-based tool execution (read, write, edit, list_dir, bash)
WORKSPACE_DIR=../../
