# Demo 3 (MCP Agent) — copy to `.env` and edit.
# One file for Nest, Vite, and the stdio mcp-server (inherits WORKSPACE_DIR).

PORT=3003
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen2.5-1.5b-instruct
LLM_API_KEY=lm-studio
MAX_RETRY_ATTEMPTS=2
WORKSPACE_DIR=../sandbox

VITE_API_BASE_URL=http://localhost:3003
VITE_LLM_BASE_URL=http://localhost:1234/v1
VITE_LLM_MODEL=qwen2.5-1.5b-instruct
VITE_LLM_API_KEY=lm-studio
