# ==============================================================================
# Demo 3 (03-mcp-agent) Environment Template
# ==============================================================================

# MCP Server
MCP_PORT=stdio

# Backend Server (Port 3003)
PORT=3003
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen3.8-4b
LLM_API_KEY=lm-studio
MCP_SERVER_COMMAND=bun
MCP_SERVER_ARGS=run ../mcp-server/src/index.ts
MAX_RETRY_ATTEMPTS=2
WORKSPACE_DIR=../

# Frontend Web (Port 5175)
VITE_API_BASE_URL=http://localhost:3003
VITE_LLM_BASE_URL=http://localhost:1234/v1
VITE_LLM_MODEL=qwen3.8-4b
VITE_LLM_API_KEY=lm-studio
