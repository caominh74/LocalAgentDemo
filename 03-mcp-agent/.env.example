# ==============================================================================
# Demo 3 (03-mcp-agent) Environment Template
# ==============================================================================

# Backend Server (Port 3003)
PORT=3003
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2
LLM_API_KEY=ollama
MAX_RETRY_ATTEMPTS=2

# MCP Subprocess
MCP_SERVER_COMMAND=bun
MCP_SERVER_ARGS=run ../mcp-server/src/index.ts

# MCP Server Workspace
WORKSPACE_DIR=../

# Frontend Web (Port 5175)
VITE_API_BASE_URL=http://localhost:3003
