# ==============================================================================
# 03-mcp-agent: Server Environment Variables
# ==============================================================================

# Backend Port (Default: 3003)
PORT=3003

# Local LLM API Endpoint (OpenAI-compatible)
# - Ollama default: http://localhost:11434/v1
# - vLLM default:   http://localhost:8000/v1
LLM_BASE_URL=http://localhost:11434/v1

# Target Local Model Name
LLM_MODEL=llama3.2
LLM_API_KEY=ollama

# MCP Child Process Stdio Command
MCP_SERVER_COMMAND=bun
MCP_SERVER_ARGS=run ../mcp-server/src/index.ts

# Circuit Breaker Configuration
MAX_RETRY_ATTEMPTS=2
