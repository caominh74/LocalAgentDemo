# ==============================================================================
# 02-hardened-agent: Server Environment Variables
# ==============================================================================

# Backend Port (Default: 3002)
PORT=3002

# Local LLM API Endpoint (OpenAI-compatible)
# - Ollama default: http://localhost:11434/v1
# - vLLM default:   http://localhost:8000/v1
LLM_BASE_URL=http://localhost:11434/v1

# Target Local Model Name
LLM_MODEL=llama3.2
LLM_API_KEY=ollama

# Circuit Breaker Configuration
MAX_RETRY_ATTEMPTS=2

# Root directory for file-based tool execution
WORKSPACE_DIR=../../
